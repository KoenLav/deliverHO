{
  "name": "deliverho",
  "version": "0.1.0",
  "private": true,
  "description": "Booking, safety and compliance platform for a licensed Dutch escortbedrijf.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
