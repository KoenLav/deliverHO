{
  "name": "deliverho",
  "version": "0.1.0",
  "private": true,
  "description": "Booking, safety and compliance platform for a licensed Dutch escortbedrijf.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "esbuild src/web/engine.ts --bundle --format=iife --global-name=DeliverHO --target=es2020 --minify --outfile=public/engine.js && node scripts/build-web.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
