# Required. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keys the HMAC that pseudonymises workers in the municipal administration.
# Must live outside the database -- see docs/data-protection.md.
PSEUDONYM_KEY=

PORT=3000

# Set to 1 to load synthetic development data on startup. Never in production.
SEED=0
